#pragma once
// Copia este archivo a secrets.h y rellena únicamente los secretos.
// Credenciales — NO subir a git (secrets.h está en .gitignore).
// `seneca` autentica por MAC de estación y no usa contraseña WiFi. El firmware
// imprime y publica esa MAC para entregarla a Redes Uniandes.
#define WIFI_SSID       "TU_RED"
#define WIFI_PASSWORD   ""

// TLS necesita hora válida antes de conectarse. [M33] El primero es KIVA
// (chrony sirviendo hora a la planta): con el broker local, el reloj también
// debe ser local, o un reinicio sin internet deja el equipo fuera de MQTT.
// El segundo es solarblivinglabx (campus, RTC con batería); el tercero,
// internet, solo si seneca permite UDP/123 hacia fuera.
#define NTP_SERVER_1    "pool.ntp.org"
#define NTP_SERVER_2    "time.google.com"
#define NTP_SERVER_3    "pool.ntp.org"
// HiveMQ o Mosquitto local con TLS. El firmware usa WiFiClientSecure, por lo
// que el broker debe ofrecer un listener TLS, recomendado en el puerto 8883.
// No apuntar esta configuracion a un listener plano 1883.
#define MQTT_HOST       "TU_BROKER"
#define MQTT_PORT       8883
#define MQTT_USER       "TU_USUARIO_MQTT"
#define MQTT_PASS       "TU_PASSWORD_MQTT"
#define MQTT_CLIENT_ID  "WebMaster_Solar"
#define AP_FALLBACK_SSID "SolarMaster_AP"
#define AP_FALLBACK_PASS "TU_PASSWORD_AP"

// Token de los puntos de control HTTP ([M4]).
// Generar uno propio:   openssl rand -hex 24
#define API_TOKEN       "CAMBIAR_ESTE_TOKEN"

// CA del broker MQTT (certificado publico de la autoridad que firma el
// certificado del broker). Pega aqui el PEM completo. Para un broker en la
// nube suele ser la raiz publica de su proveedor (p. ej. ISRG Root X1); para
// un Mosquitto local, la CA propia con la que se firmo su certificado.
static const char MQTT_CA_CERT[] = R"pem(
-----BEGIN CERTIFICATE-----
PEGA_AQUI_EL_CERTIFICADO_PEM_DE_LA_CA
-----END CERTIFICATE-----
)pem";
